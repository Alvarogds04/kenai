<?xml version="1.0" encoding="utf-8"?>
<!-- The picture the Widget picker shows on Android 11 (no previewLayout there): the waiting card, anxious Koda in the top corner where
     the count sits beside him, and «Revisar el pedido» as the orange bar along the bottom. A layer list cannot hold text. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/widget_card_attention" />
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp"
        android:drawable="@drawable/widget_tint_attention" />
    <item
        android:width="44dp"
        android:height="44dp"
        android:left="12dp"
        android:top="12dp"
        android:gravity="top|start"
        android:drawable="@drawable/preview_char_waiting" />
    <item
        android:height="48dp"
        android:left="12dp"
        android:right="12dp"
        android:bottom="12dp"
        android:gravity="bottom|fill_horizontal"
        android:drawable="@drawable/widget_badge_bg" />
</layer-list>
