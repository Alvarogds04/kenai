<?xml version="1.0" encoding="utf-8"?>
<!-- «Aprobaciones pendientes» (kenai-0.1 S9, screen 5). Two arrangements on the same card, one shown at a time:
     - alert_column: calm (Koda resting, «Todo tranquilo» / «Nada te necesita»), not connected, and the narrow 2x2 card, centred as before;
     - alert_wide: something waits and there is room. Koda and «2 te esperan» over the computer's name, one row per waiting agent (its own
       colour, its name, «Espera tu sí» / «Tiene una pregunta») and «Revisar el pedido». The rows take what the button leaves, so on a short
       card they are cut, never the button.
     Plain RemoteViews; colours from the shared palette. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alert_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card">

    <FrameLayout
        android:id="@+id/alert_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:background="@drawable/widget_tint_muted" />

    <LinearLayout
        android:id="@+id/alert_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp">

        <ImageView
            android:id="@+id/alert_face"
            android:src="@drawable/preview_char_idle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_alert_label"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/alert_offline"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_offline"
            android:visibility="gone" />

        <TextView
            android:id="@+id/alert_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_tone_attention_text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/alert_calm"
            android:text="@string/widget_initial_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="@dimen/widget_text_name"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alert_sub"
            android:text="@string/widget_initial_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="@dimen/widget_text_state" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/alert_wide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/widget_pad"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/alert_wide_face"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/widget_alert_label"
                android:scaleType="fitCenter"
                android:src="@drawable/preview_char_waiting" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/alert_wide_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_tone_attention_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/alert_wide_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="@dimen/widget_text_state" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/alert_rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="6dp">

            <LinearLayout
                android:id="@+id/alert_row0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="2dp">

                <ImageView
                    android:id="@+id/alert_dot0"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/widget_button_bg"
                    android:importantForAccessibility="no"
                    android:padding="1dp"
                    android:src="@drawable/widget_dot" />

                <TextView
                    android:id="@+id/alert_name0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_state"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/alert_state0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="@dimen/widget_text_state" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/alert_row1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="2dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/alert_dot1"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/widget_button_bg"
                    android:importantForAccessibility="no"
                    android:padding="1dp"
                    android:src="@drawable/widget_dot" />

                <TextView
                    android:id="@+id/alert_name1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_state"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/alert_state1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="@dimen/widget_text_state" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/alert_row2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="2dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/alert_dot2"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/widget_button_bg"
                    android:importantForAccessibility="no"
                    android:padding="1dp"
                    android:src="@drawable/widget_dot" />

                <TextView
                    android:id="@+id/alert_name2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="@dimen/widget_text_state"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/alert_state2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="@dimen/widget_text_state" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/alert_review"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="@dimen/widget_row_min"
            android:paddingHorizontal="12dp"
            android:text="@string/action_review"
            android:textColor="@color/widget_on_tone"
            android:textSize="@dimen/widget_text_name"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
