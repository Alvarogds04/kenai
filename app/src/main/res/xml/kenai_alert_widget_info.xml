<?xml version="1.0" encoding="utf-8"?>
<!-- «Aprobaciones pendientes» (kenai-0.1 S9, screen 5): placed 3x2 so the agents that wait and «Revisar el pedido» fit; it can grow to
     4x2 and shrink to the calm 2x2 card it was before. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="31"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/widget_alert"
    android:previewImage="@drawable/widget_preview_image_alert"
    android:previewLayout="@layout/widget_preview_alert"
    android:description="@string/widget_alert_description" />
