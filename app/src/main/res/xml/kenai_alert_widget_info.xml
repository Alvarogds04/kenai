<?xml version="1.0" encoding="utf-8"?>
<!-- RETIRED in KN-13 (L6) and kept declared for one release: a placed instance survives and renders «Sesiones y actividad», whose pending
     section holds its rows and its button. Hidden from the picker on Android 12 and later; before that it stays listed, labelled "(retired)". -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="31"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="hide_from_picker"
    android:initialLayout="@layout/widget_glance"
    android:previewImage="@drawable/widget_preview_image_alert"
    android:previewLayout="@layout/widget_preview_alert"
    android:description="@string/widget_alert_description" />
