<?xml version="1.0" encoding="utf-8"?>
<!-- RETIRED in KN-13 (L6) and kept declared for one release: a placed instance survives and renders «Sesiones y actividad». Hidden from the
     picker on Android 12 and later; before that it stays listed, labelled "(retired)". -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="31"
    android:minWidth="250dp"
    android:minHeight="192dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:minResizeWidth="180dp"
    android:minResizeHeight="150dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="hide_from_picker"
    android:initialLayout="@layout/widget_glance"
    android:previewImage="@drawable/widget_preview_image_list"
    android:previewLayout="@layout/widget_preview_list"
    android:description="@string/widget_list_description" />
