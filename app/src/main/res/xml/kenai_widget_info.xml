<?xml version="1.0" encoding="utf-8"?>
<!-- «Sesiones y actividad» (KN-13): placed at 4x3 so five agent rows, the pending section, the button and the finished-today line fit;
     it can grow and shrink to whatever the launcher allows, and draws fewer rows when it gets less room. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="31"
    android:minWidth="250dp"
    android:minHeight="192dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:minResizeWidth="180dp"
    android:minResizeHeight="150dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/widget_glance"
    android:previewImage="@drawable/widget_preview_image_glance"
    android:previewLayout="@layout/widget_preview_glance"
    android:description="@string/widget_description" />
